# --- Application (Production) ---
PORT=8080
ENVIRONMENT=production

# --- CORS (Production) ---
# Update with your actual production frontend domains
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Cookies (Production) ---
COOKIE_DOMAINS=yourdomain.com,.yourdomain.com
SECURE_COOKIE=true

# --- Database (MongoDB Atlas) ---
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/much_todo_db?retryWrites=true&w=majority
DB_NAME=much_todo_db

# --- Authentication (Production) ---
# CRITICAL: Use a strong, randomly generated secret in production
# Generate with: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET_IN_PRODUCTION
JWT_EXPIRATION_HOURS=72

# --- Caching (ElastiCache) ---
ENABLE_CACHE=true
# Format: your-elasticache-endpoint.cache.amazonaws.com:6379
REDIS_ADDR=your-redis-endpoint.cache.amazonaws.com:6379
REDIS_PASSWORD=your-redis-auth-token

# --- Logging (CloudWatch) ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- AWS Configuration (for CloudWatch Logs) ---
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=/aws/ec2/starttech/backend
CLOUDWATCH_LOG_STREAM=production

# --- Optional: Rate Limiting ---
# RATE_LIMIT_MAX_REQUESTS=1000
# RATE_LIMIT_WINDOW=1h
